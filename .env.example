# PostgreSQL is active in Phase 2. Supply real values via environment variables.
# Example format: Host=localhost;Port=5432;Database=fleet_management;Username=<user>;Password=<password>
ConnectionStrings__DefaultConnection=
# Optional integration test connection, requiring CREATE DATABASE permission.
FMS_TEST_POSTGRES=
# Development only; false by default. --seed-only is the one-off CLI alternative.
Seed__Enabled=false
# Phase 3 and later integrations (not active in Phase 2):
Jwt__SigningKey=
Jwt__Issuer=FleetManagement
Jwt__Audience=FleetManagement.Web
AzureStorage__ConnectionString=
AzureStorage__ContainerName=fleet-files
SendGrid__ApiKey=
SendGrid__FromEmail=
Seed__Password=
