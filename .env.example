# Supply actual values through environment/configuration. ASP.NET Core does not load this file automatically.
ConnectionStrings__DefaultConnection=
# Test connection needs CREATE DATABASE; tests create/drop only isolated fms_test_* databases.
FMS_TEST_POSTGRES=
# REQUIRED: generate a cryptographically random key of at least 64 UTF-8 bytes.
Jwt__SigningKey=
Jwt__Issuer=FleetManagement
Jwt__Audience=FleetManagement.Web
Jwt__LifetimeMinutes=15
# HTTPS in deployment; loopback HTTP allowed only in Development.
PasswordReset__PublicBaseUrl=http://localhost:5173
# Development-only PRIVATE folder. Suggested absolute path: <workspace>/.tools/password-resets
PasswordReset__DevelopmentPickupDirectory=
# Optional persistent private Data Protection key directory; configure production encryption separately.
DataProtection__KeyDirectory=
Authentication__RequestsPerMinute=20
# Development fixtures and demo accounts require explicit opt-in and a strong private password.
Seed__Enabled=false
Seed__Password=
# Later integrations:
AzureStorage__ConnectionString=
AzureStorage__ContainerName=fleet-files
SendGrid__ApiKey=
SendGrid__FromEmail=
